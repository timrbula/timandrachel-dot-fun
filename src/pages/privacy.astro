---
import BaseLayout from "../components/astro/BaseLayout.astro";
import Marquee from "../components/react/Marquee";
import BlinkingText from "../components/react/BlinkingText";
import RainbowDivider from "../components/react/RainbowDivider";
import GeoButton from "../components/react/GeoButton";
---

<BaseLayout
  title="Privacy Policy - Rachel & Tim 🔒"
  description="How we collect, use, and protect your information on our wedding website."
>
  <!-- Top Marquee -->
  <Marquee client:load speed={15}>
    🔒 Privacy Policy 🔒 Your info is safe with us 🔒
  </Marquee>

  <div class="container">
    <!-- Page Header -->
    <section class="page-header text-center">
      <h1 class="text-3d">
        <BlinkingText client:load speed="slow">🔒</BlinkingText>
        Privacy Policy
        <BlinkingText client:load speed="slow">🔒</BlinkingText>
      </h1>
      <p class="subtitle">Last updated: {new Date().toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}</p>
    </section>

    <RainbowDivider client:load variant="animated" />

    <!-- Content -->
    <section class="policy-section">
      <div class="policy-card geo-box-raised">
        <h2 class="text-neon-pink">What Information We Collect</h2>
        <p>
          When you RSVP, sign our guestbook, or contact us, we may collect
          the following information:
        </p>
        <ul>
          <li>Your name, email address, and phone number</li>
          <li>RSVP details (attendance, plus-one, meal preferences, dietary restrictions)</li>
          <li>Song requests and special accommodation notes</li>
          <li>Messages you post in our public guestbook</li>
        </ul>
      </div>

      <div class="policy-card geo-box-raised">
        <h2 class="text-neon">How We Use Your Information</h2>
        <p>We use the information you provide solely to plan our wedding, including:</p>
        <ul>
          <li>Managing our guest list and seating arrangements</li>
          <li>Sending RSVP confirmations and event updates via email or SMS</li>
          <li>Accommodating dietary restrictions and special requests</li>
        </ul>
        <p>We will never sell your information or use it for marketing purposes.</p>
      </div>

      <div class="policy-card geo-box-raised">
        <h2 class="text-neon-pink">Guestbook Messages</h2>
        <p>
          Messages posted to our guestbook are public and visible to anyone
          who visits this site. Please don't include sensitive personal
          information in your guestbook posts.
        </p>
      </div>

      <div class="policy-card geo-box-raised">
        <h2 class="text-neon">Who Can See Your Information</h2>
        <p>
          Your RSVP and contact details are only accessible to Rachel and
          Tim (and immediate family helping with wedding planning). We use
          trusted third-party services to operate this site, including:
        </p>
        <ul>
          <li>Supabase for database storage</li>
          <li>Resend for sending confirmation emails</li>
          <li>Twilio for sending SMS updates</li>
        </ul>
        <p>
          These providers only process your information on our behalf to
          deliver the service (e.g. transmitting a text message or email) and
          are not permitted to use it for their own marketing purposes.
        </p>
      </div>

      <div class="policy-card geo-box-raised">
        <h2 class="text-neon-pink">SMS / Text Messaging</h2>
        <p>
          If you provide a phone number, we may use it to send you SMS text
          messages about our wedding, such as RSVP reminders, schedule
          updates, and day-of logistics.
        </p>
        <ul>
          <li>
            <strong>No mobile information (including phone numbers and
            SMS opt-in/consent data) will be shared or sold to any third
            party or affiliate for marketing or promotional purposes.</strong>
          </li>
          <li>
            Your phone number is used solely to send you wedding-related
            updates and is never used for advertising.
          </li>
          <li>Message frequency varies. Message and data rates may apply.</li>
          <li>
            Reply <strong>STOP</strong> to any text message at any time to
            opt out of future messages, or <strong>HELP</strong> for help.
          </li>
          <li>
            Text messages are sent using Twilio, which acts only as our
            messaging service provider and does not use your information for
            its own purposes.
          </li>
        </ul>
      </div>

      <div class="policy-card geo-box-raised">
        <h2 class="text-neon">Data Retention</h2>
        <p>
          We keep your RSVP information until after our wedding celebration
          concludes, at which point it will be deleted unless you ask us to
          keep it for keepsake purposes.
        </p>
      </div>

      <div class="policy-card geo-box-raised">
        <h2 class="text-neon">Your Choices</h2>
        <p>
          You can update or remove your RSVP information at any time by
          contacting us. Just reach out using the details below.
        </p>
      </div>
    </section>

    <RainbowDivider client:load variant="dots" />

    <!-- Contact Section -->
    <section class="contact-section">
      <div class="contact-box geo-box-neon text-center">
        <h2 class="text-3d">
          <BlinkingText client:load>💬</BlinkingText>
          Questions About Your Privacy?
          <BlinkingText client:load>💬</BlinkingText>
        </h2>
        <div class="contact-methods">
          <p>
            📧 Email: <a href="mailto:hello@rachelandtim.fun" class="text-cyan"
              >hello@rachelandtim.fun</a
            >
          </p>
        </div>
        <div class="cta-buttons">
          <GeoButton client:load variant="primary" href="/">
            🏠 Back to Home
          </GeoButton>
        </div>
      </div>
    </section>
  </div>

  <!-- Bottom Marquee -->
  <Marquee client:load speed={20} direction="right">
    💕 Can't wait to celebrate with you! 🎉 RSVP by August 28th, 2026 💌
  </Marquee>
</BaseLayout>

<style>
  /* Page Header */
  .page-header {
    padding: 2rem 0;
  }

  .page-header h1 {
    font-size: 3.5rem;
    margin-bottom: 1rem;
  }

  .subtitle {
    font-size: 1.1rem;
    max-width: 700px;
    margin: 0 auto;
  }

  /* Policy Section */
  .policy-section {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 800px;
    margin: 3rem auto;
  }

  .policy-card {
    padding: 2rem;
  }

  .policy-card h2 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }

  .policy-card p {
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .policy-card ul {
    margin: 0 0 1rem 1.5rem;
    line-height: 1.6;
  }

  .policy-card li {
    margin-bottom: 0.5rem;
  }

  /* Contact Section */
  .contact-section {
    margin: 3rem 0;
  }

  .contact-box {
    max-width: 700px;
    margin: 0 auto;
    padding: 2.5rem;
  }

  .contact-methods {
    margin-top: 2rem;
  }

  .contact-methods p {
    margin-bottom: 0.8rem;
    font-size: 1.1rem;
  }

  .cta-buttons {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }

  /* Links */
  a {
    text-decoration: underline;
  }

  a:hover {
    opacity: 0.8;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .page-header h1 {
      font-size: 2.5rem;
    }

    .subtitle {
      font-size: 1rem;
    }
  }
</style>
