---
import BaseLayout from "../components/astro/BaseLayout.astro";
import Marquee from "../components/react/Marquee";
import BlinkingText from "../components/react/BlinkingText";
import RainbowDivider from "../components/react/RainbowDivider";
import GeoButton from "../components/react/GeoButton";
import AddToCalendarButton from "../components/react/AddToCalendarButton";
import UnderConstruction from "@/components/react/UnderConstruction";

const WELCOME_VENUE = "Threes Brewing";
const WELCOME_ADDRESS = "333 Douglass St, Brooklyn, NY 11217";
const WELCOME_DATE = "Thursday, October 8th, 2026";
const WELCOME_TIME = "7:00 PM";

const CEREMONY_VENUE = "Manhattan City Clerk's Office";
const CEREMONY_ADDRESS = "141 Worth Street, New York, NY 10013";
const CEREMONY_DATE = "Thursday, October 8th, 2026";
const CEREMONY_TIME = "3:30 PM";

const WEDDING_VENUE = "Neptune Room @ Radio Star";
const WEDDING_ADDRESS = "13 Greenpoint Ave, Brooklyn, NY 11222";
const WEDDING_DATE = "Friday, October 9th, 2026";
const WEDDING_TIME = "6:00 PM";

const AFTERPARTY_VENUE = "Goldie's Bar";
const AFTERPARTY_ADDRESS = "195 Nassau Ave, Brooklyn, NY 11222";
const AFTERPARTY_DATE = "Friday, October 9th, 2026";
const AFTERPARTY_TIME = "11:30 PM";

const PICNIC_VENUE = "Prospect Park - Near Picnic House";
const PICNIC_ADDRESS = "40 West Dr, Brooklyn, NY 11215";
const PICNIC_DATE = "Saturday, October 10th, 2026";
const PICNIC_TIME = "11:15 AM";

// Calendar event details
const WELCOME_START = "2026-10-08T19:00:00-04:00"; // 7:00 PM EDT
const WELCOME_END = "2026-10-08T22:00:00-04:00";
const WELCOME_DESCRIPTION = "Come get some drinks on us the night before. We'll have a bar tab and the brewery has food. Children, parents and friends are more than welcome! "

const CEREMONY_START = "2026-10-08T15:30:00-04:00"; // 3:30 PM EDT
const CEREMONY_END = "2026-10-08T17:00:00-04:00";
const CEREMONY_DESCRIPTION = "OPTIONAL! We will be legally married at City Hall. Unfortunately, only few witnesses are allowed inside. This is your event if you want to see us come out of the building after and clap. Please clap."

const WEDDING_START = "2026-10-09T18:00:00-04:00"; // 6:00 PM EDT
const WEDDING_END = "2026-10-09T23:00:00-04:00"; // 11:00 PM EDT
const WEDDING_DESCRIPTION =
  "Join us for our wedding celebration! Welcome drinks start at 6:00 PM followed dinner, dessert and dancing. We can't wait to celebrate with you!";

const AFTERPARTY_START = "2026-10-09T23:30:00-04:00"; // 11:30 PM EDT
const AFTERPARTY_END = "2026-10-10T01:30:00-04:00"; // 1:30 AM EDT
const AFTERPARTY_DESCRIPTION =
  "If you still have some energy join us after. We've got a private karaoke room booked.";

const PICNIC_START = "2026-10-10T11:15:00-04:00"; // 11:00 AM EDT
const PICNIC_END = "2026-10-10T13:15:00-04:00"; // 1:00 PM EDT
const PICNIC_DESCRIPTION =
  "Join us in our park of choice for some catered breakfast sandwhiches, pastries and coffee. We'll be hanging out for a bit!";
---

<BaseLayout
  title="Schedule - Rachel & Tim 📅"
  description="All the details for our wedding weekend!"
>
  <!-- Top Marquee -->
  <Marquee client:load speed={15}>
    📅 Schedule 📅 October 8th-10th, 2026 📅
  </Marquee>

  <div class="container">
    <!-- Page Header -->
    <section class="page-header text-center">
      <h1 class="text-3d">
        <BlinkingText client:load speed="slow">🕐</BlinkingText>
        Schedule
        <BlinkingText client:load speed="slow">🕐</BlinkingText>
      </h1>
    </section>

    <!-- Ceremony Date & Time -->
    <section class="date-section">
      <div class="date-box geo-box-neon text-center">
      <h1 class="text-beveled-orange">Ceremony</h1>
        <h2 class="text-neon">📅 {CEREMONY_DATE}</h2>
        <p class="ceremony-time rainbow-text">{CEREMONY_TIME}</p>
        <p class="venue-name text-neon-pink">{CEREMONY_VENUE}</p>
        <p class="venue-address">{CEREMONY_ADDRESS}</p>
        <AddToCalendarButton
          client:load
          eventTitle="Rachel & Tim's Ceremony"
          eventDescription={CEREMONY_DESCRIPTION}
          location={CEREMONY_ADDRESS}
          startDate={CEREMONY_START}
          endDate={CEREMONY_END}
          variant="primary"
        />
        <p style="margin-top: 1rem;">{CEREMONY_DESCRIPTION}</p>
      </div>
    </section>

      <!-- Welcome -->
    <section class="date-section">
      <div class="date-box geo-box-neon text-center">
        <h1 class="text-beveled-green">Welcome Party</h1>
        <h2 class="text-neon">📅 {WELCOME_DATE}</h2>
        <p class="ceremony-time rainbow-text">{WELCOME_TIME}</p>
        <p class="venue-name text-neon-pink">{WELCOME_VENUE}</p>
        <p class="venue-address">{WELCOME_ADDRESS}</p>
        <AddToCalendarButton
          client:load
          eventTitle="Rachel & Tim's Welcome Party"
          eventDescription={WELCOME_DESCRIPTION}
          location={WELCOME_ADDRESS}
          startDate={WELCOME_START}
          endDate={WELCOME_END}
          variant="secondary"
        />
        <p style="margin-top: 1rem;">{WELCOME_DESCRIPTION}</p>
      </div>
     
    </section>

    <!-- Reception Date & Time -->
    <section class="date-section">
      <div class="date-box geo-box-neon text-center">
      <h1 class="text-beveled-red">Wedding Reception</h1>
        <h2 class="text-neon">📅 {WEDDING_DATE}</h2>
        <p class="ceremony-time rainbow-text">{WEDDING_TIME}</p>
        <p class="venue-name text-neon-pink">{WEDDING_VENUE}</p>
        <p class="venue-address">{WEDDING_ADDRESS}</p>
        <AddToCalendarButton
          client:load
          eventTitle="Rachel & Tim's Wedding Reception"
          eventDescription={WEDDING_DESCRIPTION}
          location={WEDDING_ADDRESS}
          startDate={WEDDING_START}
          endDate={WEDDING_END}
          variant="secondary"
        />
        <p style="margin-top: 1rem;">{WEDDING_DESCRIPTION}</p>
        <p style="margin-top: 1rem;">Cocktail attire. View our <a href="https://www.pinterest.com/rachelroserobinson/wedding/dress-code/">Pinterest board</a> for inspiration based on the flowers and season.</p>
      </div>
    </section>

    <!-- After Party Date & Time -->
    <section class="date-section">
      <div class="date-box geo-box-neon text-center">
      <h1 class="text-beveled-red">Afterparty Karaoke</h1>
        <h2 class="text-neon">📅 {AFTERPARTY_DATE}</h2>
        <p class="ceremony-time rainbow-text">{AFTERPARTY_TIME}</p>
        <p class="venue-name text-neon-pink">{AFTERPARTY_VENUE}</p>
        <p class="venue-address">{AFTERPARTY_ADDRESS}</p>
        <AddToCalendarButton
          client:load
          eventTitle="Rachel & Tim's Afterparty"
          eventDescription={AFTERPARTY_DESCRIPTION}
          location={AFTERPARTY_ADDRESS}
          startDate={AFTERPARTY_START}
          endDate={AFTERPARTY_END}
          variant="secondary"
        />
        <p style="margin-top: 1rem;">{AFTERPARTY_DESCRIPTION}</p>
      </div>
    </section>

     <!-- Picnic Date & Time -->
    <section class="date-section">
      <div class="date-box geo-box-neon text-center">
        <h1 class="text-beveled-blue">Picnic</h1>
        <h2 class="text-neon">📅 {PICNIC_DATE}</h2>
        <p class="ceremony-time rainbow-text">{PICNIC_TIME}</p>
        <p class="venue-name text-neon-pink">{PICNIC_VENUE}</p>
        <p class="venue-address">{PICNIC_ADDRESS}</p>
        <AddToCalendarButton
          client:load
          eventTitle="Rachel & Tim's Picnic"
          eventDescription={PICNIC_DESCRIPTION}
          location={PICNIC_ADDRESS}
          startDate={PICNIC_START}
          endDate={PICNIC_END}
          variant="primary"
        />
        <p style="margin-top: 1rem;">{PICNIC_DESCRIPTION}</p>
      </div>
    </section>

    <RainbowDivider client:load variant="animated" />

    <RainbowDivider client:load variant="stars" />

    <RainbowDivider client:load variant="solid" />

      <section class="cta-section text-center">
        <h1 class="text-center">Places</h2>
      <p style="font-weight:bold">Check out Maps list to see all of the event locations in one convenient place :)</p>
       <GeoButton client:load variant="primary" href="https://maps.app.goo.gl/iHQQ5XgZBPAFLebU8">Google Maps List</GeoButton>
       </section>

    <!-- Map Section -->
         </section>
      <section class="map-section">
      <h2 class="text-center">📍 Ceremony 📍</h2>
      <div class="map-container geo-box">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3024.1284070861348!2d-74.00438902397418!3d40.715189671393134!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89c25a223276b7eb%3A0xe67517c553a9a1b!2sCity%20Clerks%20Office!5e0!3m2!1sen!2sus!4v1791317902085!5m2!1sen!2sus"
          width="100%"
          height="450"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Radio Star Location Map"></iframe>
      </div>
    </section>
    <section class="map-section">
      <h2 class="text-center">📍 Welcome Party 📍</h2>
      <div class="map-container geo-box">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d12105.087771549255!2d-73.98115170425285!3d40.66797670236825!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89c25bab47b7fbff%3A0x7ddcbcc39bb2c360!2sThrees%20Brewing!5e0!3m2!1sen!2sus!4v1777848282156!5m2!1sen!2sus"
          width="100%"
          height="450"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Radio Star Location Map"></iframe>
      </div>
    <section class="map-section">
      <h2 class="text-center">📍 Reception 📍</h2>
      <div class="map-container geo-box">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3023.4646460365666!2d-73.96273948795883!3d40.72980033640552!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89c259003a3591cd%3A0xb2fd69b7319785a6!2sThe%20Neptune%20Room!5e0!3m2!1sen!2sus!4v1777848572967!5m2!1sen!2sus"
          width="100%"
          height="450"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Radio Star Location Map"></iframe>
      </div>
    </section>
    <section class="map-section">
      <h2 class="text-center">📍 Afterparty 📍</h2>
      <div class="map-container geo-box">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3023.650389475839!2d-73.94514029999999!3d40.7257122!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89c25948d98c971f%3A0x436aa07b769ffe0f!2sGoldie's%20Bar!5e0!3m2!1sen!2sus!4v1789844094212!5m2!1sen!2sus"
          width="100%"
          height="450"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Goldie's Location Map"></iframe>
      </div>
    </section>
    <section class="map-section">
      <h2 class="text-center">📍 Picnic 📍</h2>
      <div class="map-container geo-box">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3026.2688836581265!2d-73.9751267435742!3d40.66804411642369!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89c25b055bfa3cc5%3A0x313dd59571c32a1f!2sThe%20Picnic%20House%20in%20Prospect%20Park!5e0!3m2!1sen!2sus!4v1789835307374!5m2!1sen!2sus"
          width="100%"
          height="450"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Radio Star Location Map"></iframe>
      </div>
    </section>

    <!-- Additional Info -->
    <!-- <section class="additional-info">
      <div class="info-grid">
        <div class="info-card geo-box-raised">
          <h3>🌤️ October Weather</h3>
          <p><strong>Expected Conditions:</strong></p>
          <p>🌡️ High: 64°F (18°C)</p>
          <p>🌡️ Low: 50°F (10°C)</p>
          <p><strong>What to Bring:</strong></p>
          <p>🧥 Light jacket or wrap</p>
          <p>👗 Layers are your friend!</p>
          <p class="weather-note">
            October in NYC is beautiful with fall foliage! 🍂
          </p>
        </div>
      </div>
    </section> -->

    <RainbowDivider client:load variant="stars" />

    <!-- CTA Section -->
    <section class="cta-section text-center geo-box-neon">
      <h2 class="text-3d">
        <BlinkingText client:load>🎉</BlinkingText>
        Ready to Party?
        <BlinkingText client:load>🎉</BlinkingText>
      </h2>
      <p class="cta-text">Don't forget to RSVP so we know you're coming!</p>
      <GeoButton client:load variant="warning" href="/rsvp">
        💌 RSVP Now!
      </GeoButton>
      <div class="cta-links">
        <GeoButton client:load variant="secondary" href="/travel">
          ✈️ Travel Info
        </GeoButton>
        <GeoButton client:load variant="primary" href="/">
          🏠 Back to Home
        </GeoButton>
      </div>
    </section>
  </div>

  <!-- Bottom Marquee -->
  <Marquee client:load speed={20} direction="right">
    🎉 See you on October 9th, 2026! 📅 Neptune Room @ Radio Star, Brooklyn, NY
    🗽 Let's celebrate! 💕
  </Marquee>
</BaseLayout>

<style>
  /* Page Header */
  .page-header {
    padding: 2rem 0;
  }

  .page-header h1 {
    font-size: 3.5rem;
    margin-bottom: 1rem;
  }

  .subtitle {
    font-size: 1.3rem;
    max-width: 700px;
    margin: 0 auto;
  }

  /* Date Section */
  .date-section {
    margin: 3rem 0;
  }

  .date-box {
    max-width: 600px;
    margin: 0 auto;
    padding: 2.5rem;
  }

  .date-box h2 {
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  .ceremony-time {
    font-size: 2.5rem;
    font-weight: bold;
    margin: 1rem 0;
  }

  .venue-name {
    font-size: 1.8rem;
    font-weight: bold;
    margin: 1rem 0;
  }

  .venue-address {
    font-size: 1.2rem;
    color: var(--color-cyan);
  }

  /* Timeline */
  .timeline-section {
    margin: 3rem 0;
  }

  .timeline {
    max-width: 800px;
    margin: 2rem auto;
  }

  .timeline-item {
    display: flex;
    gap: 2rem;
    padding: 2rem;
    margin-bottom: 1rem;
    align-items: flex-start;
  }

  .timeline-icon {
    font-size: 3rem;
    flex-shrink: 0;
  }

  .timeline-content h3 {
    font-size: 1.8rem;
    margin-bottom: 0.5rem;
  }

  .timeline-content p {
    margin-bottom: 0.5rem;
    line-height: 1.6;
  }

  .timeline-arrow {
    margin: 1rem 0;
  }

  .arrow-down {
    font-size: 2rem;
    animation: bounce 2s infinite;
  }

  @keyframes bounce {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(10px);
    }
  }

  /* Venue Section */
  .venue-section {
    margin: 3rem 0;
  }

  .venue-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 2rem;
    max-width: 1000px;
    margin: 2rem auto;
  }

  .venue-info,
  .subway-info {
    padding: 2rem;
  }

  .venue-info h3,
  .subway-info h3 {
    font-size: 1.8rem;
    margin-bottom: 1rem;
  }

  .venue-description {
    margin: 1.5rem 0;
    line-height: 1.6;
  }

  .subway-routes {
    margin: 1.5rem 0;
  }

  .subway-routes ul {
    margin: 0.5rem 0 1rem 1.5rem;
  }

  .subway-routes li {
    margin-bottom: 0.3rem;
  }

  .subway-tip {
    margin-top: 1.5rem;
    padding: 1rem;
    background: rgba(255, 255, 0, 0.1);
    border: 2px dashed var(--color-yellow);
    border-radius: 8px;
  }

  /* Map Section */
  .map-section {
    margin: 3rem 0;
  }

  .map-container {
    max-width: 900px;
    margin: 2rem auto;
    padding: 1rem;
  }

  .map-container iframe {
    border-radius: 8px;
  }

  /* Additional Info */
  .additional-info {
    margin: 3rem 0;
  }

  .info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    max-width: 1100px;
    margin: 0 auto;
  }

  .info-card {
    padding: 2rem;
  }

  .info-card h3 {
    font-size: 1.6rem;
    margin-bottom: 1rem;
    color: var(--color-cyan);
  }

  .info-card ul {
    margin: 0.5rem 0 1rem 1.5rem;
  }

  .info-card li {
    margin-bottom: 0.3rem;
  }

  .parking-tip,
  .weather-note,
  .accessibility-note {
    margin-top: 1rem;
    font-size: 0.95rem;
  }

  /* CTA Section */
  .cta-section {
    max-width: 700px;
    margin: 3rem auto;
    padding: 3rem 2rem;
  }

  .cta-text {
    font-size: 1.2rem;
    margin: 1.5rem 0;
  }

  .cta-links {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .page-header h1 {
      font-size: 2.5rem;
    }

    .subtitle {
      font-size: 1.1rem;
    }

    .ceremony-time {
      font-size: 2rem;
    }

    .venue-name {
      font-size: 1.5rem;
    }

    .timeline-item {
      flex-direction: column;
      gap: 1rem;
      padding: 1.5rem;
    }

    .timeline-icon {
      font-size: 2.5rem;
    }

    .venue-grid {
      grid-template-columns: 1fr;
    }

    .info-grid {
      grid-template-columns: 1fr;
    }

    .cta-links {
      flex-direction: column;
    }
  }
</style>
